# TEMPLATE ONLY -- this file IS committed. Never put real keys here.
#
#   cp .env.example .env      then fill the values in .env
#
# .env is git-ignored; .env.example is not. Only the keys for the models you
# actually run are required.

# Google AI Studio key (https://aistudio.google.com/apikey)
# GOOGLE_API_KEY is also accepted; GEMINI_API_KEY wins if both are set.
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: HF token, only needed for gated open-weight checkpoints
HF_TOKEN=
